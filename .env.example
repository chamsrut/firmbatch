# Template only. Copy to .env and fill in locally; .env is gitignored and no agent may
# read or write it. Every value here is a non-secret placeholder.

# --- v1 control plane (control_plane/, Milestone 2) --------------------------------
# Explicit environment selection. No default exists: a process that has not said which
# environment it is gets no database.
FIRMBATCH_ENV=test                  # test | production

# Application access. A restricted, non-owner, NOSUPERUSER, NOBYPASSRLS role, subject to
# the row-level security policies. This is what the API/controller/validator connect as.
# The identity is verified against the live catalogue on every connection, not taken on
# trust from the URL: a superuser, a BYPASSRLS role, a tenant-table owner, or a role that
# can SET ROLE to any of those is refused at connect time.
FIRMBATCH_DATABASE_URL=postgresql+psycopg://APP_ROLE:PASSWORD@HOST:5432/DATABASE

# Migration and admin access. The schema owner. Kept in a separate variable so the
# privilege split is a configuration fact rather than a convention.
FIRMBATCH_MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER_ROLE:PASSWORD@HOST:5432/DATABASE

# Admin MAINTENANCE connection used only by the test suite, which creates its own
# disposable `firmbatch_test_<random>` database and throwaway roles from here and drops
# them afterwards. It must point at `postgres` or `template1`; the helpers refuse
# anything else. The suite FAILS when this is unset -- it never skips.
# The admin role needs CREATEDB and CREATEROLE, and needs neither SUPERUSER nor BYPASSRLS.
#
# EVERY field must be explicit: user, host, port and database. libpq fills whatever a URL
# omits from PGUSER/PGHOST/PGPORT/PGDATABASE, so an omitted field means the environment --
# not this file -- decides where the connection goes and who it goes as. Multi-host
# failover lists are refused for the same reason: libpq would pick one at connect time.
#
# Local WSL (native PostgreSQL 16, peer auth over the unix socket). Note the explicit port:
FIRMBATCH_TEST_DATABASE_URL=postgresql+psycopg://YOUR_OS_USER@/postgres?host=/var/run/postgresql&port=5432
# CI or a TCP server:
# FIRMBATCH_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
#
# The server must ALSO carry an explicit disposable-cluster marker before the helpers will
# create or drop anything. Every PostgreSQL cluster has a `postgres` database, so the URL
# alone is not evidence that a server is throwaway. Once per cluster, and never on a
# server holding anything you would miss:
#
#   cd "$(git rev-parse --show-toplevel)/.."
#   FIRMBATCH_ENV=test python3 -m firmbatch.control_plane.testing.attestation --mark
#
# Equivalently:
#   CREATE ROLE firmbatch_disposable_test_cluster NOLOGIN;
#   COMMENT ON ROLE firmbatch_disposable_test_cluster IS 'firmbatch-disposable-test-cluster';

# --- v0 prototype (frozen; see ADR 0003) -------------------------------------------
FB_TOKEN=change-me
FB_DB=firmbatch.db
FB_LEASE_SECS=90          # a worker that misses this many seconds of heartbeat loses its shard
FB_TICK=15                # controller loop period
FB_BUFFER_FRAC=0.20       # keep 20% of the window as slack

# verda  (https://cloud.verda.com -> Keys -> REST API)
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
VERDA_LOCATION=FIN-03     # FIN-01 | FIN-02 | FIN-03 | ICE-01
VERDA_INSTANCE_TYPE=      # get real names from `fb probe`
VERDA_IMAGE=ubuntu-24.04-cuda-12.8-open-docker
VERDA_SSH_KEY_IDS=        # comma separated, optional but useful for debugging
